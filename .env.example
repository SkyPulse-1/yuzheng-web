# Web
NEXT_PUBLIC_APP_NAME=语证
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Legacy global display value; the app enforces PDF 100MB, DOCX 50MB, TXT 30MB.
NEXT_PUBLIC_MAX_UPLOAD_MB=100

# Supabase public browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional compatibility for older Supabase projects
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase server only — never prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
# Optional compatibility with legacy Supabase service-role keys
SUPABASE_SERVICE_ROLE_KEY=
USERNAME_AUTH_SECRET=
ACCOUNT_RECOVERY_SECRET=

# HiAgent server only
HIAGENT_BASE_URL=
HIAGENT_API_KEY=
HIAGENT_CREATE_CONVERSATION_PATH=/create_conversation
HIAGENT_CHAT_PATH=/chat_query_v2
HIAGENT_TRUSTED_FILTERS_ENABLED=false

# Optional: only after the school administrator provides and verifies it.
HIAGENT_UP_UPLOAD_ENDPOINT=
